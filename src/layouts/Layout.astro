---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CountryCurrency from '../components/CountryCurrency.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Elevate — Escrowed AI Account Exchange & Team Network',
  description =
    'AI Elevate buys verified Outlier, Micro1, Mercor or Handshake AI accounts for $30, or offers a one-time $50 team membership and 90% of every task you complete.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />}
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CountryCurrency />
  </body>
</html>
