---
import MessageCircle from '@lucide/astro/icons/message-circle';

const year = 2026;
---

<footer class="border-t border-border bg-card">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5">
          <img src="/images/logo.png" alt="AI Elevate logo" class="h-8 w-8 rounded-lg object-cover" />
          <span class="text-base font-bold">AI <span class="text-primary">Elevate</span></span>
        </div>
        <p class="mt-3 max-w-xs text-sm text-muted-foreground">
AI Elevate accepts account-sale and team-membership applications for manual review.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Platform</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/#sell-account" class="hover:text-primary">Sell an Account — $30</a></li>
          <li><a href="/#join" class="hover:text-primary">Join the Team — $50</a></li>
          <li><a href="/#team-dashboard" class="hover:text-primary">Team Dashboard</a></li>
          <li><a href="/#sale-process" class="hover:text-primary">Account Sale Process</a></li>
          <li><a href="/#bots" class="hover:text-primary">How It Works</a></li>
          <li><button type="button" data-open-country class="text-left hover:text-primary">Country &amp; Currency</button></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Support</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/#faq" class="hover:text-primary">FAQ</a></li>
          <li><a href="mailto:info@aielevategroup.top" class="hover:text-primary">Company questions: info@aielevategroup.top</a></li>
          <li><a href="mailto:accounts@aielevategroup.top" class="hover:text-primary">Account sales &amp; acquisition: accounts@aielevategroup.top</a></li>
          <li>
            <div class="space-y-2">
              <button
                type="button"
                data-whatsapp-start
                aria-controls="whatsapp-handoff-status"
                class="inline-flex items-center gap-2 rounded-md border border-border bg-secondary px-3 py-2 font-medium hover:bg-secondary/70"
              >
                <MessageCircle class="h-4 w-4" /> WhatsApp customer care
              </button>
              <div id="whatsapp-handoff-status" data-whatsapp-status hidden aria-live="polite" class="text-sm text-muted-foreground">
                <p data-whatsapp-searching>Checking for the next available customer-care contact…</p>
                <div data-whatsapp-ready hidden>
                  <p>Customer-care contact: <strong class="text-foreground">+1 (954) 856-8448</strong></p>
                  <a
                    href="https://wa.me/19548568448?text=Hello%2C%20I%20have%20a%20question%20for%20AI%20Elevate%20customer%20care."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-1 inline-block text-primary underline underline-offset-4"
                  >Open WhatsApp</a>
                </div>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-8 border-t border-border pt-6 text-center text-xs text-muted-foreground">
      <p>&copy; {year} AI Elevate. Membership checkout activates after payment verification. Account-sale review and seller payment are handled manually; this site does not provide escrow.</p>
    </div>
  </div>
</footer>

<script>
  const whatsappButton = document.querySelector<HTMLButtonElement>('[data-whatsapp-start]');
  const whatsappStatus = document.querySelector<HTMLElement>('[data-whatsapp-status]');
  const whatsappSearching = document.querySelector<HTMLElement>('[data-whatsapp-searching]');
  const whatsappReady = document.querySelector<HTMLElement>('[data-whatsapp-ready]');

  whatsappButton?.addEventListener('click', () => {
    if (!whatsappStatus || !whatsappSearching || !whatsappReady) return;
    whatsappButton.disabled = true;
    whatsappStatus.hidden = false;
    window.setTimeout(() => {
      whatsappSearching.hidden = true;
      whatsappReady.hidden = false;
    }, 1200);
  });
</script>
