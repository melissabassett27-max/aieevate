---
// Site-wide "Where are you located?" welcome modal + currency conversion.
// Rendered once in Layout.astro. Displays prices in the visitor's currency
// while keeping USD as the base accounting currency.
---

<div
  data-country-modal
  hidden
  class="fixed inset-0 z-[100] flex items-center justify-center p-4"
>
  <div data-country-backdrop class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="country-modal-title"
    class="relative z-10 w-full max-w-lg overflow-hidden rounded-2xl border border-border bg-card shadow-2xl"
  >
    <div class="border-b border-border bg-secondary/40 px-5 py-4">
      <p class="text-xs font-medium uppercase tracking-wider text-primary">Welcome to AI Elevate</p>
      <h2 id="country-modal-title" class="mt-1 text-xl font-bold tracking-tight">Where are you located?</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        We'll show prices in your local currency. USD stays our base accounting currency.
      </p>
    </div>

    <div class="p-5">
      <label for="country-search" class="sr-only">Search countries</label>
      <input
        id="country-search"
        data-country-search
        type="text"
        placeholder="Search country or currency…"
        autocomplete="off"
        class="w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/40"
      />

      <div data-country-list class="mt-3 max-h-72 space-y-1 overflow-y-auto pr-1"></div>

      <p class="mt-4 text-xs text-muted-foreground">
        You can change this any time from <strong class="text-foreground">Country &amp; Currency</strong> in the header or footer.
      </p>
    </div>
  </div>
</div>

<script>
  type Country = {
    name: string;
    full?: string;
    currency: string;
    flag: string;
    rate: number;
    locale: string;
    storeAs?: string;
  };

  const COUNTRIES: Country[] = [
    { name: 'United Kingdom', currency: 'GBP', flag: 'gb', rate: 0.79, locale: 'en-GB' },
    { name: 'Germany', currency: 'EUR', flag: 'de', rate: 0.92, locale: 'de-DE' },
    { name: 'France', currency: 'EUR', flag: 'fr', rate: 0.92, locale: 'fr-FR' },
    { name: 'Italy', currency: 'EUR', flag: 'it', rate: 0.92, locale: 'it-IT' },
    { name: 'Spain', currency: 'EUR', flag: 'es', rate: 0.92, locale: 'es-ES' },
    { name: 'Netherlands', currency: 'EUR', flag: 'nl', rate: 0.92, locale: 'nl-NL' },
    { name: 'Switzerland', currency: 'CHF', flag: 'ch', rate: 0.88, locale: 'de-CH' },
    { name: 'Canada', currency: 'CAD', flag: 'ca', rate: 1.36, locale: 'en-CA' },
    { name: 'United States', currency: 'USD', flag: 'us', rate: 1, locale: 'en-US' },
    { name: 'Alaska', full: 'Alaska (United States)', currency: 'USD', flag: 'us', rate: 1, locale: 'en-US', storeAs: 'United States' },
    { name: 'Australia', currency: 'AUD', flag: 'au', rate: 1.52, locale: 'en-AU' },
    { name: 'New Zealand', currency: 'NZD', flag: 'nz', rate: 1.64, locale: 'en-NZ' },
  ];

  const STORAGE_KEY = 'ai-elevate:country';
  const symbolFor: Record<string, string> = { GBP: '£', EUR: '€', USD: '$', CHF: 'CHF', CAD: 'C$', AUD: 'A$', NZD: 'NZ$' };

  type Saved = { country: string; label: string; region: string | null; currency: string; rate: number; locale: string; flag: string };

  function readSaved(): Saved | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Saved) : null;
    } catch {
      return null;
    }
  }

  function saveCountry(c: Country): Saved {
    const saved: Saved = {
      country: c.storeAs ?? c.name,
      label: c.full ?? c.name,
      region: c.name === 'Alaska' ? 'Alaska' : null,
      currency: c.currency,
      rate: c.rate,
      locale: c.locale,
      flag: c.flag,
    };
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
    } catch {
      /* storage unavailable — conversion still applies for this session */
    }
    return saved;
  }

  function formatPrice(usd: number, saved: Saved): string {
    const amount = usd * saved.rate;
    try {
      return new Intl.NumberFormat(saved.locale, {
        style: 'currency',
        currency: saved.currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(amount);
    } catch {
      return `${symbolFor[saved.currency] ?? saved.currency}${amount.toFixed(2)}`;
    }
  }

  function applyCurrency(saved: Saved) {
    document.querySelectorAll<HTMLElement>('[data-usd]').forEach((el) => {
      const usd = parseFloat(el.getAttribute('data-usd') || '');
      if (!Number.isNaN(usd)) el.textContent = formatPrice(usd, saved);
    });
    document.querySelectorAll<HTMLElement>('[data-currency-code]').forEach((el) => {
      el.textContent = saved.currency;
    });
    document.querySelectorAll<HTMLImageElement>('[data-currency-flag]').forEach((el) => {
      el.src = `https://flagcdn.com/w40/${saved.flag}.png`;
      el.alt = saved.country;
    });
    document.querySelectorAll<HTMLElement>('[data-currency-country]').forEach((el) => {
      el.textContent = saved.region ? `${saved.region}` : saved.country;
    });
  }

  const modal = document.querySelector<HTMLElement>('[data-country-modal]');
  const list = document.querySelector<HTMLElement>('[data-country-list]');
  const search = document.querySelector<HTMLInputElement>('[data-country-search]');
  const backdrop = document.querySelector<HTMLElement>('[data-country-backdrop]');

  function renderList(query: string) {
    if (!list) return;
    const q = query.trim().toLowerCase();
    const matches = COUNTRIES.filter((c) => {
      const hay = `${c.full ?? c.name} ${c.name} ${c.currency}`.toLowerCase();
      return hay.includes(q);
    });
    list.innerHTML = '';
    if (matches.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'px-2 py-6 text-center text-sm text-muted-foreground';
      empty.textContent = 'No match — try another country.';
      list.appendChild(empty);
      return;
    }
    matches.forEach((c) => {
      const saved = readSaved();
      const active = saved && (saved.country === (c.storeAs ?? c.name)) && (c.name !== 'Alaska' || saved.region === 'Alaska');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'flex w-full items-center gap-3 rounded-lg border px-3 py-2.5 text-left text-sm transition-colors ' +
        (active ? 'border-primary/50 bg-primary/10' : 'border-transparent hover:border-border hover:bg-secondary/60');
      btn.innerHTML = `<img src="https://flagcdn.com/w40/${c.flag}.png" alt="" width="24" height="18" class="h-[18px] w-6 rounded-[3px] object-cover" loading="lazy" />
        <span class="flex-1 font-medium">${c.full ?? c.name}</span>
        <span class="text-xs text-muted-foreground">${c.currency} ${symbolFor[c.currency] ?? ''}</span>`;
      btn.addEventListener('click', () => {
        const savedValue = saveCountry(c);
        applyCurrency(savedValue);
        closeModal();
      });
      list.appendChild(btn);
    });
  }

  function openModal() {
    if (!modal) return;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    if (search) search.value = '';
    renderList('');
    window.setTimeout(() => search?.focus(), 50);
  }

  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  search?.addEventListener('input', () => renderList(search.value));
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
  });

  document.addEventListener('ai-elevate:open-country', openModal);
  document.querySelectorAll<HTMLElement>('[data-open-country]').forEach((el) => {
    el.addEventListener('click', openModal);
  });

  // On first visit, ask where the visitor is; otherwise apply the saved choice.
  const existing = readSaved();
  if (existing) {
    applyCurrency(existing);
  } else {
    // default to USD until they choose, then prompt
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', openModal, { once: true });
    } else {
      openModal();
    }
  }
</script>
