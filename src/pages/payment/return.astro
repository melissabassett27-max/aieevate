---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Membership payment status — AI Elevate">
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <h1 class="text-3xl font-bold">Membership payment</h1>
    <p data-payment-status role="status" aria-live="polite" class="mt-4 text-muted-foreground">Checking your payment status…</p>
    <a data-dashboard-link href="/#team-dashboard" hidden class="mt-6 inline-flex rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground">Go to member dashboard</a>
    <a href="/#join" class="mt-6 ml-3 inline-flex rounded-md border border-border px-5 py-3 text-sm font-semibold">Back to AI Elevate</a>
  </section>
</Layout>

<script>
  const statusElement = document.querySelector<HTMLElement>('[data-payment-status]');
  const dashboardLink = document.querySelector<HTMLAnchorElement>('[data-dashboard-link]');
  const params = new URLSearchParams(window.location.search);
  const reference = params.get('reference');
  const paymentId = params.get('payment_id');
  const attemptHash = params.get('pay_request_hash');

  if (!reference || !paymentId || !attemptHash) {
    if (statusElement) statusElement.textContent = 'Payment confirmation details were not returned. If you completed checkout, contact info@aielevategroup.top.';
  } else {
    const verifyPayment = async () => {
      const query = new URLSearchParams({
        reference,
        payment_id: paymentId,
        pay_request_hash: attemptHash,
      });
      const response = await fetch(`/api/allpays-callback?${query.toString()}`);
      const result = await response.json().catch(() => null);
      if (!response.ok && response.status !== 202) throw new Error(result?.error || 'Could not verify payment');
      return result;
    };

    const checkPayment = async () => {
      try {
        const result = await verifyPayment();
        if (result.status === 'paid') {
          if (statusElement) statusElement.textContent = 'Payment confirmed. Sign in or create your member account with the same email you used on your application to access the dashboard.';
          if (dashboardLink) dashboardLink.hidden = false;
        } else if (result.status === 'failed') {
          if (statusElement) statusElement.textContent = 'This payment attempt timed out. You can try again using the checkout link sent by the team.';
        } else if (statusElement) {
          statusElement.textContent = 'Payment is still processing. Checking again shortly; membership activates after confirmation.';
          window.setTimeout(() => void checkPayment(), 5000);
        }
      } catch (error) {
        if (statusElement) statusElement.textContent = `${error instanceof Error ? error.message : 'Could not verify payment'}. Contact info@aielevategroup.top if you were charged.`;
      }
    };

    void checkPayment();
  }
</script>
