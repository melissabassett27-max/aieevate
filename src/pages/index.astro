<script>
  function setupWizard(root: HTMLElement) {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const backBtn = root.querySelector<HTMLButtonElement>('[data-nav="back"]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-nav="next"]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]');
    let current = 0;

    const show = (index: number) => {
      current = index;
      panels.forEach((p, i) => {
        p.hidden = i !== index;
      });
      if (backBtn) backBtn.hidden = index === 0;
      if (nextBtn) nextBtn.hidden = index === panels.length - 1;
      if (submitBtn) submitBtn.hidden = index !== panels.length - 1;
      const dots = document.querySelectorAll('[data-escrow-tracker] [data-tracker-dot]');
      dots.forEach((d, i) => {
        if (i <= index + 1) {
          d.classList.add('border-primary', 'bg-primary', 'text-primary-foreground');
          d.classList.remove('border-border', 'bg-secondary', 'text-muted-foreground');
        }
      });
    };

    const valid = (index: number) => {
      const fields = Array.from(panels[index].querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select'));
      return fields.every((f) => f.checkValidity());
    };

    nextBtn?.addEventListener('click', () => {
      if (!valid(current)) {
        panels[current].querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((f) => f.reportValidity());
        return;
      }
      show(Math.min(current + 1, panels.length - 1));
    });

    backBtn?.addEventListener('click', () => show(Math.max(current - 1, 0)));
    show(0);
  }

  document.querySelectorAll<HTMLElement>('form[data-wizard]').forEach(setupWizard);

  /* Optional CV picker — uploads are not enabled until a storage flow is configured. */
  document.querySelectorAll<HTMLInputElement>('[data-cv-input]').forEach((input) => {
    input.addEventListener('change', () => {
      const label = input.parentElement?.querySelector<HTMLElement>('[data-cv-name]');
      if (!label) return;
      const file = input.files && input.files[0];
      label.textContent = file ? `Attached: ${file.name}` : 'No file selected.';
    });
  });

  document.querySelectorAll<HTMLFormElement>('form[data-form-id]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const successPanel = document.getElementById(`${form.dataset.formId}-success`);
      const errorPanel = document.getElementById(`${form.dataset.formId}-error`);
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!form.reportValidity()) return;

      if (successPanel) successPanel.hidden = true;
      if (errorPanel) errorPanel.hidden = true;
      if (submitButton) submitButton.disabled = true;

      const payload = Object.fromEntries(new FormData(form).entries());
      try {
        const response = await fetch('/api/submit-intake', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            form: form.dataset.formId === 'sell-account-form' ? 'account-sale' : 'team-application',
            data: payload,
          }),
        });
        if (!response.ok) throw new Error('Submission failed');
        form.hidden = true;
        if (successPanel) successPanel.hidden = false;
      } catch {
        if (errorPanel) errorPanel.hidden = false;
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  });
</script>
