---
import Layout from '../layouts/Layout.astro';
import TeamDashboard from '../components/TeamDashboard';
import MemberAuth from '../components/MemberAuth';
import BotVerifier from '../components/BotVerifier';
import { Check, Bot, Banknote, ClipboardList, Star, Users, ArrowRight, AlertTriangle, BadgeCheck } from '@lucide/astro';

const SELL_FORM_ID = 'sell-account-form';
const JOIN_FORM_ID = 'team-application-form';

const botFleet = [
  {
    name: 'Account sale',
    stage: '$30 offer · manual review',
    role: 'Submit account details for human review. Do not submit your password. Accepted offers and seller payment are arranged manually.',
  },
  {
    name: 'Team application',
    stage: '$50 one-time membership',
    role: 'An administrator reviews applications. Approved applicants receive a hosted checkout link; access activates after payment is verified.',
  },
  {
    name: 'Member dashboard',
    stage: 'Paid memberships only',
    role: 'Paid members can view their Supabase dashboard data. Account assignment, task tracking, and evaluations are not connected yet.',
  },
  {
    name: 'Seller payment',
    stage: 'Manual arrangement',
    role: 'The site does not hold escrow or send seller payouts. If an offer is accepted, payment is arranged separately by the team.',
  },
];

const demoBotChecks = [
  { label: 'Sample application', detail: 'illustrative demo only' },
  { label: 'Sample review', detail: 'no account is accessed or verified' },
  { label: 'Sample decision', detail: 'no real records are changed' },
];

const inputClass =
  'w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/40';

const labelClass = 'block text-sm font-medium mb-1.5';

const saleSteps = [
  {
    icon: ClipboardList,
    title: '1. Submit details',
    body: 'Tell us which platform your account is on and provide contact and payout details. Never submit your password.',
  },
  {
    icon: ClipboardList,
    title: '2. Manual review',
    body: 'The team reviews your submission. The website does not verify platform credentials or check account standing.',
  },
  {
    icon: BadgeCheck,
    title: '3. Offer decision',
    body: 'If the team accepts the account, they contact you to confirm the offer and arrange the $30 seller payment.',
  },
  {
    icon: Banknote,
    title: '4. Manual payment',
    body: 'Seller payment is not processed by this site and is not held in escrow. No payment is due when you submit the form.',
  },
];

const faqs = [
  {
    q: 'How does the $30 account offer work?',
    a: 'Submit your account details for manual review. The form does not collect your password, verify the account, or take payment. If the team accepts the account, they contact you to confirm the $30 offer and arrange payment manually.',
  },
  {
    q: 'Does the website verify accounts automatically?',
    a: 'No. Account review is manual; the interactive bot panel is only a sample simulation. The website does not log in to third-party platforms or hold escrow.',
  },
  {
    q: 'How does the $50 team membership work?',
    a: 'It is a one-time $50 fee, not a subscription. Applications are reviewed manually. After approval, the team sends a hosted checkout link; membership activates after payment verification. Account assignment is handled separately and is not automated yet.',
  },
  {
    q: 'How is the 90/10 split applied?',
    a: 'The 90/10 split is the stated team arrangement. Task tracking, calculation, and member payouts are not automated or connected to a payout provider in this app yet.',
  },
  {
    q: 'When do I get paid?',
    a: 'Team payouts are not processed by this website. If an account-sale offer is accepted, the $30 seller payment is arranged manually; no escrow or automatic transfer is provided.',
  },
  {
    q: 'How do I pay the $50 team membership fee?',
    a: 'After approval, the team creates a hosted $50 checkout link and sends it to you. Payment is confirmed server-side before membership is activated.',
  },
  {
    q: 'What happens if I submit a fake or duplicate account?',
    a: 'Submit only accounts you own and are permitted to transfer. The website does not check credentials or detect duplicates automatically; the team reviews submissions manually.',
  },
];
---

<Layout>
  <!-- Hero -->
  <section id="hero" class="relative overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-2 md:py-24">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
          <ClipboardList class="h-3.5 w-3.5" /> Account review by the team
        </span>
        <span class="ml-2 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-3 py-1 text-xs font-medium text-muted-foreground">
          One-time membership · <span data-usd="50">$50</span>
        </span>
        <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">
          Sell your AI training account for <span class="text-primary" data-usd="30">$30</span> — or join the team.
        </h1>
        <p class="mt-4 text-lg text-muted-foreground">
          Submit an account for manual review for a <span data-usd="30">$30</span> seller offer. Team membership costs <span data-usd="50">$50</span>; approved applicants receive a secure checkout link.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#sell-account" class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90">
            Sell my account for <span data-usd="30">$30</span> <ArrowRight class="h-4 w-4" />
          </a>
          <a href="#join" class="inline-flex items-center gap-2 rounded-md border border-border bg-secondary px-5 py-3 text-sm font-semibold hover:bg-secondary/70">
            Join the team — <span data-usd="50">$50</span>
          </a>
        </div>
        <dl class="mt-8 grid grid-cols-3 gap-4 text-center">
          <div class="rounded-lg border border-border bg-card p-3">
            <dt class="text-xs text-muted-foreground">Account sale review</dt>
            <dd class="text-xl font-bold text-primary">Manual</dd>
          </div>
          <div class="rounded-lg border border-border bg-card p-3">
            <dt class="text-xs text-muted-foreground">Seller payment</dt>
            <dd class="text-xl font-bold text-primary">Manual</dd>
          </div>
          <div class="rounded-lg border border-border bg-card p-3">
            <dt class="text-xs text-muted-foreground">Membership</dt>
            <dd class="text-xl font-bold text-primary">After approval</dd>
          </div>
        </dl>
      </div>
      <div class="overflow-hidden rounded-2xl border border-border shadow-2xl">
        <img
          src="/images/hero-escrow.jpg"
          alt="Illustration of an account review and membership workflow"
          class="h-full w-full object-cover"
          width="1264"
          height="848"
        />
      </div>
    </div>
  </section>

  <!-- Application workflows -->
  <section id="bots" class="border-b border-border">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
          <ClipboardList class="h-3.5 w-3.5" /> Manual review · no password collection
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight">How applications are handled</h2>
        <p class="mx-auto mt-2 max-w-2xl text-muted-foreground">
          Account-sale and membership applications are reviewed by the team. Account checks, assignment, task scoring, and payouts are not automated by this website.
        </p>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        <div class="grid gap-5 sm:grid-cols-2 lg:col-span-2">
          {botFleet.map((bot, i) => (
            <div class="rounded-xl border border-border bg-card p-5">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/15 text-primary">
                  <ClipboardList class="h-5 w-5" />
                </span>
                <div>
                  <p class="font-semibold">{bot.name}</p>
                  <p class="text-xs text-muted-foreground">Stage {i + 1} · {bot.stage}</p>
                </div>
              </div>
              <p class="mt-3 text-sm text-muted-foreground">{bot.role}</p>
            </div>
          ))}
        </div>
        <div class="lg:col-span-1">
          <BotVerifier
            client:visible
            title="Sample review simulation"
            subtitle="Illustrative only; no account is accessed"
            buttonLabel="Run sample"
            checks={demoBotChecks}
            resultTitle="Sample complete"
            resultBody="This demo does not access an account, create an escrow, or change an application. Actual submissions are reviewed manually."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Account sale process -->
  <section id="sale-process" class="border-y border-border bg-card/50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight">How the <span data-usd="30">$30</span> account offer works</h2>
      <p class="mx-auto mt-2 max-w-2xl text-center text-muted-foreground">
        Submissions are reviewed manually. This site does not hold funds in escrow or verify third-party account credentials.
      </p>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {saleSteps.map((step) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary/15 text-primary">
              <step.icon class="h-6 w-6" />
            </div>
            <h3 class="mt-4 font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Account sale application -->
  <section id="sell-account" class="mx-auto max-w-3xl px-4 py-16">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight">Submit an account for a <span data-usd="30">$30</span> offer</h2>
      <p class="mt-2 text-muted-foreground">
        The team reviews submissions manually. No payment is collected here; accepted seller payments are arranged manually.
      </p>
    </div>

    <!-- Application status tracker -->
    <div class="mt-8 grid grid-cols-4 gap-2 text-center" data-process-tracker>
      {['Submit', 'Review', 'Decision', 'Manual payment'].map((label, i) => (
        <div class="flex flex-col items-center gap-1.5">
          <div
            class={`flex h-8 w-8 items-center justify-center rounded-full border text-sm font-semibold ${i === 0 ? 'border-primary bg-primary text-primary-foreground' : 'border-border bg-secondary text-muted-foreground'}`}
            data-tracker-dot
          >
            {i + 1}
          </div>
          <span class="text-xs text-muted-foreground">{label}</span>
        </div>
      ))}
    </div>

    <div class="mt-6 rounded-2xl border border-border bg-card p-6 md:p-8">
      <form data-form-id={SELL_FORM_ID} data-wizard novalidate>
        <div class="absolute left-[-10000px]" aria-hidden="true">
          <label for="sell-website">Leave this field empty</label>
          <input id="sell-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <!-- Step 1: platform -->
        <fieldset data-step-panel data-step-index="0">
          <legend class="text-lg font-semibold mb-1">Which platform is the account on?</legend>
          <p class="mb-4 text-sm text-muted-foreground">We buy accounts on these four platforms only.</p>
          <div class="grid grid-cols-2 gap-3">
            {['Outlier', 'Micro1', 'Mercor', 'Handshake AI'].map((p) => (
              <label class="cursor-pointer">
                <input type="radio" name="platform" value={p} required class="peer sr-only" />
                <span class="block rounded-lg border border-border bg-background px-4 py-4 text-center text-sm font-medium transition-colors peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary">
                  {p}
                </span>
              </label>
            ))}
          </div>
          <div class="mt-4 flex items-start gap-2.5 rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-sm text-destructive">
            <AlertTriangle class="mt-0.5 h-4 w-4 shrink-0" />
            <span><strong>Submit only accounts you own and may transfer.</strong> The team reviews applications manually. Do not submit your account password or any login secret.</span>
          </div>
        </fieldset>

        <!-- Step 2: account details -->
        <fieldset data-step-panel data-step-index="1" hidden>
          <legend class="text-lg font-semibold mb-4">Account details</legend>
          <div class="space-y-4">
            <div>
              <label for="account_login" class={labelClass}>Account login (email or username) <span class="text-destructive">*</span></label>
              <input id="account_login" name="account_login" type="text" required placeholder="you@platform.com" class={inputClass} />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="account_standing" class={labelClass}>Account standing <span class="text-destructive">*</span></label>
                <select id="account_standing" name="account_standing" required class={inputClass}>
                  <option value="">Select standing…</option>
                  <option>In good standing with completed tasks</option>
                  <option>Active but idle recently</option>
                  <option>Under review</option>
                </select>
              </div>
              <div>
                <label for="monthly_earnings" class={labelClass}>Monthly earnings on the account (USD) <span class="text-destructive">*</span></label>
                <input id="monthly_earnings" name="monthly_earnings" type="text" required placeholder="e.g. 120" class={inputClass} />
              </div>
            </div>
            <div>
              <label for="account_age" class={labelClass}>How long have you had this account? <span class="text-destructive">*</span></label>
              <select id="account_age" name="account_age" required class={inputClass}>
                <option value="">Select account age…</option>
                <option>Less than 1 month</option>
                <option>1–3 months</option>
                <option>3–6 months</option>
                <option>6–12 months</option>
                <option>Over 1 year</option>
              </select>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="full_name" class={labelClass}>Your full name <span class="text-destructive">*</span></label>
                <input id="full_name" name="full_name" type="text" required class={inputClass} />
              </div>
              <div>
                <label for="contact_email" class={labelClass}>Contact email <span class="text-destructive">*</span></label>
                <input id="contact_email" name="contact_email" type="email" required class={inputClass} />
              </div>
            </div>
            <div>
              <label for="payout_method" class={labelClass}>Preferred payout method <span class="text-destructive">*</span></label>
              <select id="payout_method" name="payout_method" required class={inputClass}>
                <option value="">Select payout method…</option>
                <option>Bitcoin (BTC)</option>
                <option>Crypto (USDT)</option>
                <option>PayPal</option>
                <option>Bank transfer</option>
                <option>Wise</option>
              </select>
            </div>
          </div>
        </fieldset>

        <!-- Step 3: review consent -->
        <fieldset data-step-panel data-step-index="2" hidden>
          <legend class="text-lg font-semibold mb-4">Review and seller payment terms</legend>
          <div class="rounded-lg border border-primary/30 bg-primary/10 p-4 text-sm">
            <p class="flex items-center gap-2 font-semibold text-primary"><ClipboardList class="h-4 w-4" /> Before you submit</p>
            <ul class="mt-2 space-y-1 text-muted-foreground">
              <li>• This form stores an application; it does not collect payment or create escrow.</li>
              <li>• The team reviews the account details manually; automated account verification is not available.</li>
              <li>• If accepted, the team confirms the <strong class="text-foreground"><span data-usd="30">$30</span></strong> offer and arranges seller payment separately.</li>
              <li>• Do not transfer account access until you have reviewed and accepted the final terms.</li>
            </ul>
          </div>
          <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-lg border border-border bg-background p-4">
            <input type="checkbox" name="review_consent" required class="mt-0.5 h-4 w-4 accent-[var(--primary)]" />
            <span class="text-sm">
              I own this account, have permission to offer it, and understand that submission is not a sale, payment, or escrow agreement.
              <span class="text-destructive">*</span>
            </span>
          </label>
        </fieldset>

        <!-- Nav -->
        <div class="mt-6 flex items-center justify-between gap-3">
          <button type="button" data-nav="back" hidden class="rounded-md border border-border bg-secondary px-5 py-2.5 text-sm font-semibold hover:bg-secondary/70">Back</button>
          <span></span>
          <button type="button" data-nav="next" class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90">Next <ArrowRight class="h-4 w-4" /></button>
          <button type="submit" data-submit hidden class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90">
            Submit for a <span data-usd="30">$30</span> offer review
          </button>
        </div>
      </form>

      <!-- Application confirmation -->
      <div id={`${SELL_FORM_ID}-success`} hidden class="mt-2">
        <div class="rounded-xl border border-primary/40 bg-primary/10 p-6">
          <p class="flex items-center gap-2 text-lg font-semibold text-primary">
            <Check class="h-5 w-5" /> Account details received
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            Your account details are saved for manual review. No escrow or payment was created by this submission.
          </p>
          <ol class="mt-4 space-y-3 text-sm">
            <li data-process-row="received" data-state="done" class="flex items-start gap-3">
              <span data-escrow-icon class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">1</span>
              <span><strong>Details received</strong> — your application is stored for review.</span>
            </li>
            <li data-process-row="review" data-state="pending" class="flex items-start gap-3">
              <span data-escrow-icon class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-border text-xs font-semibold text-muted-foreground">2</span>
              <span><strong>Team review</strong> — this is handled manually.</span>
            </li>
            <li data-process-row="offer" data-state="pending" class="flex items-start gap-3">
              <span data-escrow-icon class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-border text-xs font-semibold text-muted-foreground">3</span>
              <span><strong>Offer</strong> — if accepted, the team contacts you about the $30 offer.</span>
            </li>
            <li data-process-row="payment" data-state="pending" class="flex items-start gap-3">
              <span data-escrow-icon class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-border text-xs font-semibold text-muted-foreground">4</span>
              <span><strong>Seller payment</strong> — arranged manually only after acceptance.</span>
            </li>
          </ol>
          <p class="mt-4 rounded-lg border border-border bg-secondary/40 px-4 py-3 text-sm text-muted-foreground">
            This form does not ask for or store your account password. Do not send passwords by email.
          </p>
        </div>
      </div>
      <div id={`${SELL_FORM_ID}-error`} hidden class="mt-2 rounded-lg border border-destructive/40 bg-destructive/10 p-4 text-sm text-destructive">
        Something went wrong submitting your account. Please try again or contact accounts@aielevategroup.top.
      </div>
    </div>

    <!-- Cross-sell: join the team instead -->
    <div class="mt-6 rounded-2xl border border-border bg-card p-6 text-center md:p-8">
      <BadgeCheck class="mx-auto h-7 w-7 text-primary" />
      <h3 class="mt-2 text-xl font-bold tracking-tight">Rather not sell? Join the team for <span data-usd="50">$50</span></h3>
      <p class="mx-auto mt-2 max-w-xl text-sm text-muted-foreground">
        We'll give you your own account to manage, matched to your experience, and hand you more as the star rating from
        your application is reviewed. Account assignment and task tracking are handled separately and are not automated by this site.
      </p>
      <a href="#join" class="mt-4 inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90">
        Join the team for <span data-usd="50">$50</span> <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </section>

  <!-- Team dashboard -->
  <section id="team-dashboard" class="border-y border-border bg-card/50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight">Team member dashboard</h2>
          <p class="mt-2 max-w-2xl text-muted-foreground">
            The member dashboard is available after the <span data-usd="50">$50</span> membership payment is verified. Account assignment, task scoring, and payouts remain manual or unavailable.
          </p>
        </div>
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-3 py-1 text-xs text-muted-foreground">
          <Users class="h-3.5 w-3.5" /> Paid access · sample otherwise
        </span>
      </div>
      <div class="mt-8">
        <MemberAuth client:load />
      </div>
      <div class="mt-4">
        <TeamDashboard client:load />
      </div>
    </div>
  </section>

  <!-- Join the team -->
  <section id="join" class="mx-auto max-w-5xl px-4 py-16">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tight">Join the team — <span class="text-primary" data-usd="50">$50</span>, once, forever</h2>
        <p class="mt-3 text-muted-foreground">
          No subscription. Submit an application for review; if approved, pay USD 50.00 through the checkout link the team sends you. Your bank may convert the charge or add fees. Payment confirmation activates dashboard access.
        </p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <Star class="mt-0.5 h-5 w-5 shrink-0 text-chart-4" />
            <span><strong>Manual account assignment</strong> — assignments are not automated or guaranteed at signup.</span>
          </li>
          <li class="flex items-start gap-3">
            <Star class="mt-0.5 h-5 w-5 shrink-0 text-chart-4" />
            <span><strong>Stated 90/10 earnings split</strong> — task tracking and payout calculations are not connected yet.</span>
          </li>
          <li class="flex items-start gap-3">
            <Star class="mt-0.5 h-5 w-5 shrink-0 text-chart-4" />
            <span><strong>Future account progression</strong> — star ratings and additional assignments are not active yet.</span>
          </li>
          <li class="flex items-start gap-3">
            <BadgeCheck class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
            <span><strong>Application review</strong> — assignment decisions are made manually by the team.</span>
          </li>
        </ul>

        <div class="mt-8 grid grid-cols-3 gap-3 text-center">
          <div class="rounded-lg border border-border bg-card p-3">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">1</span>
            <p class="mt-2 text-sm font-semibold">Apply</p>
            <p class="mt-1 text-xs text-muted-foreground">Send your details</p>
          </div>
          <div class="rounded-lg border border-border bg-card p-3">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">2</span>
            <p class="mt-2 text-sm font-semibold">Pay <span data-usd="50">$50</span></p>
            <p class="mt-1 text-xs text-muted-foreground">After application approval</p>
          </div>
          <div class="rounded-lg border border-border bg-card p-3">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">3</span>
            <p class="mt-2 text-sm font-semibold">Get an account</p>
            <p class="mt-1 text-xs text-muted-foreground">Access after verification</p>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-border bg-card p-6 md:p-8">
        <form data-form-id={JOIN_FORM_ID} novalidate>
          <div class="absolute left-[-10000px]" aria-hidden="true">
