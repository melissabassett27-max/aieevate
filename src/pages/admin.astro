---
import Layout from '../layouts/Layout.astro';
import AdminApplications from '../components/AdminApplications';
---

<Layout title="Application administration — AI Elevate" noindex>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-2xl font-bold">Team applications</h1>
    <p class="mt-2 text-sm text-muted-foreground">Review applications, approve eligible applicants, and prepare their membership checkout link.</p>
    <div class="mt-8">
      <AdminApplications client:load />
    </div>
  </section>
</Layout>
