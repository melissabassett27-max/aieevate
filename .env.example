PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
PUBLIC_SITE_URL=http://localhost:4321

# Server-only Supabase values. Never prefix these with PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel serverless payment and admin configuration.
ADMIN_EMAILS=your-admin-auth-email@example.com
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret
PAYSTACK_CURRENCY=USD
# Preview tests may override this to 100 ($1.00). Live keys are fixed in code to USD 50.00.
PAYSTACK_MEMBERSHIP_AMOUNT_SUBUNIT=5000