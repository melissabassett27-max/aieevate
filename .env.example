PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
PUBLIC_SITE_URL=http://localhost:4321

# Server-only Supabase values. Never prefix these with PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel serverless payment and admin configuration.
ADMIN_EMAILS=your-admin-auth-email@example.com
ALLPAYS_POLYGON_ADDRESS=
ALLPAYS_CURRENCY=USD
ALLPAYS_MEMBERSHIP_AMOUNT=50
ALLPAYS_FEE_PAYER=merchant